<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.StudentScoreMapper">

    <select id="selectScoreByStudentIdAndSubject" resultType="java.lang.Integer">
        select score
        from student_score
        where student_id = #{studentId}
          and subject = #{subject}
        limit 1
    </select>

</mapper>
