<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.CampusCardMapper">

    <select id="selectBalanceByStudentId" resultType="java.math.BigDecimal">
        select balance
        from campus_card_account
        where student_id = #{studentId}
        limit 1
    </select>

</mapper>
